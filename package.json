{
  "name": "sintropia-carbono",
  "version": "0.1.0",
  "description": "The professional network for environmental markets and sustainability. Connecting professionals in carbon, renewable energy, ESG, and sustainability.",
  "private": true,
  "types": "./dist/index.d.mts",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src playwright.config.ts next.config.ts eslint.config.mjs --max-warnings=0",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "prepare": "husky",
    "build:ds": "tsup && tailwindcss -i src/app/globals.css -o dist/styles.css --content \"./src/components/ui/**/*.{ts,tsx}\"",
    "db:verify": "node scripts/verify-migrations.cjs",
    "db:baseline": "node scripts/generate-schema-baseline.cjs"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.98.0",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "isomorphic-dompurify": "^3.16.0",
    "lucide-react": "^0.577.0",
    "next": "^15.5.12",
    "next-intl": "^4.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.7.0",
    "resend": "^6.9.2",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "node-domexception": "^2.0.2"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/cli": "^4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18",
    "babel-plugin-react-compiler": "1.0.0",
    "depcheck": "^1.4.7",
    "dotenv": "^17.3.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "papaparse": "^5.5.3",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsup": "^8.5.0",
    "typescript": "^5",
    "typescript-eslint": "^8.60.1"
  }
}
